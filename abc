class Budget {

    constructor() {
        this.Budget = document.getElementById("budget-input");
    }

    handlebudget() {
        event.preventDefault();

        console.log(this.Budget.value);

        if (this.Budget.value === '') {
            document.getElementById("budgetInputErr").innerHTML = "Please enter budget";
        } else {
            if (isNaN(this.Budget.value) || parseInt(this.Budget.value) <= 0) {
                document.getElementById("budgetInputErr").innerHTML = "Please enter valid budget";
            } else {
                document.getElementById("budgetInputErr").innerHTML = "";
                // document.getElementById("budget").innerHTML = "$" + this.Budget.value

                localStorage.setItem("budget", this.Budget.value);
            }
        }


    }

    handleData() {
        let budgetdata = JSON.parse(localStorage.getItem("budget"));
        let expansedata = JSON.parse(localStorage.getItem("expanse"));

        if (budgetdata) {
            document.getElementById("budget-amount").innerHTML = budgetdata;
        }
        let expanseaddamt = 0

        if (expansedata) {
            expanseaddamt = expansedata.reduce((add, v) => add + parseFloat(v.amount), 0)
            document.getElementById("expense-amount").innerHTML = expanseaddamt;
        }

        document.getElementById("balance-amount").innerHTML = budgetdata - expanseaddamt

    }



}
